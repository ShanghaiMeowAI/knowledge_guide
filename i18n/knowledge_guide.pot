#. module: knowledge_guide
#: model:mail.template,body_html:knowledge_guide.email_template_send_guide
msgid ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px; color: #333333; line-height: 1.6; max-width: 640px; margin: 0 auto;\">\n"
"    <p>Hello,</p>\n"
"\n"
"    <p>Here is the knowledge guide link. Open it in your browser to view the guide.</p>\n"
"\n"
"    <p><strong>Guide:</strong> <t t-out=\"object.name\"/></p>\n"
"\n"
"    <p><strong>Access link:</strong><br/>\n"
"    <a t-att-href=\"object.tracked_url or object.public_url\" style=\"color: #714B67; text-decoration: none;\">\n"
"        <t t-out=\"object.tracked_url or object.public_url\"/>\n"
"    </a></p>\n"
"\n"
"    <p>This guide contains <t t-out=\"object.page_count\"/> pages covering system workflows and business instructions.</p>\n"
"\n"
"    <p>The link can be opened without signing in. Share it only with the intended audience.</p>\n"
"\n"
"    <p>Thank you.<br/>\n"
"    <t t-out=\"object.env.company.name\"/></p>\n"
"\n"
"    <hr style=\"border: none; border-top: 1px solid #e0e0e0; margin: 20px 0;\"/>\n"
"\n"
"    <p style=\"font-size: 12px; color: #666666;\">\n"
"        This email was sent by <t t-out=\"object.env.company.name\"/> through Odoo.\n"
"    </p>\n"
"</div>\n"
"        "
msgstr ""

