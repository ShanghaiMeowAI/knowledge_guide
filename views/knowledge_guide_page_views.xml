<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List view -->
    <record id="view_knowledge_guide_page_list" model="ir.ui.view">
        <field name="name">knowledge.guide.page.list</field>
        <field name="model">knowledge.guide.page</field>
        <field name="arch" type="xml">
            <list string="Guide Pages">
                <header>
                    <button name="%(knowledge_guide.knowledge_guide_book_create_wizard_action)d"
                            type="action"
                            string="Create Collection from Selected Pages"
                            display="always"
                            class="btn-primary"
                            icon="fa-book"/>
                </header>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="section"/>
                <field name="category"/>
                <field name="book_id" optional="show"/>
                <field name="module_source"/>
                <field name="icon"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_knowledge_guide_page_form" model="ir.ui.view">
        <field name="name">knowledge.guide.page.form</field>
        <field name="model">knowledge.guide.page</field>
        <field name="arch" type="xml">
            <form string="Guide Pages">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="section"/>
                            <field name="category"/>
                            <field name="icon"/>
                        </group>
                        <group>
                            <field name="section_sequence"/>
                            <field name="is_section_overview"/>
                            <field name="is_default_landing"/>
                            <field name="sequence"/>
                            <field name="book_id"/>
                            <field name="module_source"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Visible Groups">
                        <field name="group_ids" widget="many2many_tags" nolabel="1"/>
                        <p class="text-muted" colspan="2">
                            If no user group is selected, all internal users can view this page.
                        </p>
                    </group>
                    <group string="Odoo Navigation Button">
                        <field name="action_link_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
                                <field name="action_xmlid"/>
                                <field name="icon"/>
                            </list>
                        </field>
                        <p class="text-muted" colspan="2">
                            These buttons appear only in the internal Odoo guide and open the related business views.
                        </p>
                    </group>
                    <separator string="Custom Content"/>
                    <field name="custom_content_html" nolabel="1" options="{'codeview': true}"/>
                    <div invisible="not module_source">
                        <separator string="Original Module Content"/>
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="text-muted">
                                This content comes from module <field name="module_source" class="fw-bold d-inline" readonly="1"/>. Avoid editing the original content directly.
                                To customize the displayed text, use Custom Content above.
                            </span>
                            <button name="action_view_source_html" type="object"
                                    string="View HTML Source" class="btn btn-sm btn-secondary ms-2"
                                    icon="fa-code"/>
                        </div>
                        <field name="content_html" nolabel="1" readonly="1"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_knowledge_guide_page_search" model="ir.ui.view">
        <field name="name">knowledge.guide.page.search</field>
        <field name="model">knowledge.guide.page</field>
        <field name="arch" type="xml">
            <search string="Search Guide Pages">
                <field name="name"/>
                <field name="section"/>
                <field name="category"/>
                <field name="module_source"/>
                <field name="book_id"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_by_section" string="Top-level Directory" context="{'group_by': 'section'}"/>
                    <filter name="group_by_category" string="Category" context="{'group_by': 'category'}"/>
                    <filter name="group_by_book" string="Collection" context="{'group_by': 'book_id'}"/>
                    <filter name="group_by_module" string="Source Module" context="{'group_by': 'module_source'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_knowledge_guide_page" model="ir.actions.act_window">
        <field name="name">Guide Pages</field>
        <field name="res_model">knowledge.guide.page</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new guide page
            </p>
            <p>
                Guide pages can be organized by category and restricted to selected user groups.
            </p>
        </field>
    </record>

</odoo>
