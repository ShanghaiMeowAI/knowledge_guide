<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- List view                                                     -->
    <!-- ============================================================ -->
    <record id="view_knowledge_guide_book_list" model="ir.ui.view">
        <field name="name">knowledge.guide.book.list</field>
        <field name="model">knowledge.guide.book</field>
        <field name="arch" type="xml">
            <list string="指南合集">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="slug"/>
                <field name="page_count"/>
                <field name="is_published" widget="boolean_toggle"/>
                <field name="public_url" widget="url"/>
                <field name="module_source" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Form view                                                     -->
    <!-- ============================================================ -->
    <record id="view_knowledge_guide_book_form" model="ir.ui.view">
        <field name="name">knowledge.guide.book.form</field>
        <field name="model">knowledge.guide.book</field>
        <field name="arch" type="xml">
            <form string="指南合集">
                <header>
                    <button name="action_publish"
                            string="发布"
                            type="object"
                            class="btn-primary"
                            invisible="is_published"/>
                    <button name="action_unpublish"
                            string="取消发布"
                            type="object"
                            class="btn-secondary"
                            invisible="not is_published"/>
                    <button name="action_send_guide_email"
                            string="邮件发送"
                            type="object"
                            class="btn-primary"
                            icon="fa-envelope"
                            invisible="not is_published or not link_tracker_id"/>
                    <button name="action_regenerate_token"
                            string="重新生成 token"
                            type="object"
                            class="btn-secondary"
                            confirm="重新生成 token 会使旧链接失效，是否继续？"/>
                    <button name="action_open_public_url"
                            string="打开公开链接"
                            type="object"
                            class="btn-link"
                            icon="fa-external-link"
                            invisible="not is_published"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <widget name="web_ribbon" title="已归档" bg_color="text-bg-danger" invisible="active"/>
                        <button name="action_open_public_url"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-globe"
                                invisible="not is_published">
                            <field name="page_count" widget="statinfo" string="页面"/>
                        </button>
                        <button name="action_view_link_tracker_clicks"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-bar-chart"
                                invisible="not link_tracker_id">
                            <field name="click_count" widget="statinfo" string="访问"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="指南名称..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="slug" placeholder="my-guide"/>
                            <field name="module_source"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                            <field name="click_count" invisible="1"/>
                            <field name="tracked_url" invisible="1"/>
                        </group>
                    </group>
                    <group string="简介">
                        <field name="description_html" nolabel="1" colspan="2"/>
                    </group>
                    <notebook>
                        <page string="页面" name="pages">
                            <field name="page_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="section"/>
                                    <field name="category"/>
                                    <field name="icon"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="发布与分享" name="sharing">
                            <group>
                                <group>
                                    <field name="is_published"/>
                                    <field name="public_url" widget="CopyClipboardChar"
                                           invisible="not is_published"/>
                                </group>
                                <group>
                                    <field name="access_token" readonly="1"/>
                                </group>
                            </group>
                            <div class="alert alert-info" role="alert" invisible="not is_published">
                                <strong>公开链接：</strong> 发布后可将上方 URL 分享给读者，读者无需登录即可访问。
                                token 用于保护访问权限，重新生成 token 会使旧链接失效。
                            </div>
                            <div class="alert alert-warning" role="alert" invisible="is_published">
                                <strong>未发布：</strong> 当前指南暂不可通过公开链接访问。点击顶部“发布”后启用外部访问。
                            </div>
                            <separator string="访问跟踪"/>
                            <group>
                                <group>
                                    <field name="link_tracker_id" readonly="1"/>
                                    <field name="tracked_url" widget="CopyClipboardChar"
                                           invisible="not link_tracker_id"/>
                                </group>
                                <group>
                                    <button name="action_create_tracked_link"
                                            string="生成跟踪链接"
                                            type="object"
                                            class="btn-primary"
                                            icon="fa-link"
                                            invisible="not is_published"/>
                                </group>
                            </group>
                            <div class="alert alert-success" role="alert" invisible="not link_tracker_id">
                                <strong><i class="fa fa-bar-chart"></i> 跟踪已启用：</strong>
                                使用跟踪链接分享指南，可以在表单顶部的“访问”按钮查看统计。
                            </div>
                            <div class="alert alert-info" role="alert" invisible="link_tracker_id or not is_published">
                                <strong><i class="fa fa-info-circle"></i> 启用跟踪：</strong>
                                点击“生成跟踪链接”生成可统计访问量的链接。
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Search view                                                   -->
    <!-- ============================================================ -->
    <record id="view_knowledge_guide_book_search" model="ir.ui.view">
        <field name="name">knowledge.guide.book.search</field>
        <field name="model">knowledge.guide.book</field>
        <field name="arch" type="xml">
            <search string="搜索指南合集">
                <field name="name"/>
                <field name="slug"/>
                <field name="module_source"/>
                <filter name="published" string="已发布" domain="[('is_published', '=', True)]"/>
                <filter name="unpublished" string="未发布" domain="[('is_published', '=', False)]"/>
                <filter name="archived" string="已归档" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_by_module" string="来源模块" context="{'group_by': 'module_source'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Custom list view for link.tracker.click                       -->
    <!-- ============================================================ -->
    <record id="view_link_tracker_click_knowledge_guide_list" model="ir.ui.view">
        <field name="name">link.tracker.click.knowledge.guide.list</field>
        <field name="model">link.tracker.click</field>
        <field name="arch" type="xml">
            <list string="指南访问" create="0" edit="0" delete="0">
                <field name="create_date" string="访问时间"/>
                <field name="ip" string="IP 地址"/>
                <field name="country_id" string="国家/地区"/>
                <field name="campaign_id" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Action                                                        -->
    <!-- ============================================================ -->
    <record id="action_knowledge_guide_book" model="ir.actions.act_window">
        <field name="name">指南合集</field>
        <field name="res_model">knowledge.guide.book</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_published': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                创建一个新的指南合集
            </p>
            <p>
                指南合集可以把多个页面组成一套手册，并通过带 token 的安全链接发布给读者。
            </p>
        </field>
    </record>

</odoo>
