<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Main template -->
    <t t-name="knowledge_guide.MainTemplate">
        <div class="user-guide-container">

            <!-- Sidebar -->
            <div class="user-guide-sidebar">
                <!-- Search bar -->
                <div class="user-guide-search">
                    <div class="user-guide-language-selector" t-if="state.languages.length">
                        <label for="knowledge_guide_language">Language</label>
                        <select
                            id="knowledge_guide_language"
                            class="form-select"
                            t-att-value="state.currentLang"
                            t-on-change="onLanguageChange"
                        >
                            <t t-foreach="state.languages" t-as="language" t-key="language.code">
                                <option
                                    t-att-value="language.code"
                                    t-att-selected="language.code === state.currentLang"
                                >
                                    <t t-esc="language.name"/>
                                </option>
                            </t>
                        </select>
                    </div>
                    <input
                        type="text"
                        class="form-control"
                        placeholder="Search guide content..."
                        t-model="state.searchTerm"
                        t-on-input="onSearchInput"
                    />
                </div>

                <!-- Categories and pages list -->
                <div class="user-guide-categories">
                    <t t-if="state.loading">
                        <div style="text-align: center; padding: 20px;">
                            <i class="fa fa-spinner fa-spin fa-2x"/>
                            <p>Loading...</p>
                        </div>
                    </t>

                    <t t-elif="state.error">
                        <div style="text-align: center; padding: 20px; color: #dc3545;">
                            <i class="fa fa-exclamation-triangle fa-2x"/>
                            <p>Failed to load</p>
                        </div>
                    </t>

                    <t t-elif="state.pages.length === 0">
                        <div class="user-guide-no-results">
                            <i class="fa fa-search"/>
                            <p>No matching pages found</p>
                        </div>
                    </t>

                    <t t-else="">
                        <t t-foreach="state.sections" t-as="section" t-key="section">
                            <div class="user-guide-section">
                                <div class="user-guide-section-title"
                                     t-on-click="() => this.toggleSection(section)">
                                    <i class="fa"
                                       t-att-class="{
                                           'fa-chevron-right': !isSectionExpanded(section),
                                           'fa-chevron-down': isSectionExpanded(section)
                                       }"
                                       style="transition: transform 0.2s; width: 14px;"/>
                                    <i class="fa fa-cubes"/>
                                    <span t-esc="section"/>
                                </div>
                                <div class="user-guide-section-categories"
                                     t-att-class="{ 'collapsed': !isSectionExpanded(section) }">
                                    <t t-foreach="getCategoriesBySection(section)" t-as="category" t-key="section + '::' + category">
                                        <div class="user-guide-category">
                                            <div class="user-guide-category-title"
                                                 t-on-click="() => this.toggleCategory(getCategoryKey(section, category))">
                                                <i class="fa"
                                                   t-att-class="{
                                                       'fa-chevron-right': !isCategoryExpanded(getCategoryKey(section, category)),
                                                       'fa-chevron-down': isCategoryExpanded(getCategoryKey(section, category))
                                                   }"/>
                                                <i class="fa fa-folder-open"/>
                                                <span t-esc="category"/>
                                            </div>
                                            <div class="user-guide-category-pages"
                                                 t-att-class="{ 'collapsed': !isCategoryExpanded(getCategoryKey(section, category)) }">
                                                <t t-foreach="getPagesBySectionCategory(section, category)" t-as="page" t-key="page.id">
                                                    <div
                                                        class="user-guide-page-item"
                                                        t-att-class="{ 'active': isPageSelected(page) }"
                                                        t-on-click="() => this.selectPage(page)"
                                                    >
                                                        <i t-att-class="'fa ' + page.icon" style="margin-right: 8px;"/>
                                                        <span t-esc="page.name"/>
                                                    </div>
                                                </t>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </t>
                </div>
            </div>

            <!-- Content area -->
            <div class="user-guide-content-area">
                <t t-if="state.selectedPage">
                    <div class="user-guide-content-wrapper">
                        <t t-if="state.selectedPage.action_links.length">
                            <div class="user-guide-action-bar">
                                <t t-foreach="state.selectedPage.action_links" t-as="link" t-key="link.id">
                                    <button
                                        type="button"
                                        class="btn btn-primary user-guide-action-button"
                                        t-on-click="() => this.openGuideAction(link)"
                                    >
                                        <i t-att-class="'fa ' + link.icon"/>
                                        <span t-esc="link.name"/>
                                    </button>
                                </t>
                            </div>
                        </t>
                        <div class="user-guide-content"
                             t-on-click="onContentClick"
                             t-out="state.selectedPage.content_html"/>
                    </div>
                </t>
                <t t-else="">
                    <div class="user-guide-empty-state">
                        <i class="fa fa-book"/>
                        <h3>Knowledge Guide</h3>
                        <p>Select a section from the left to start reading.</p>
                    </div>
                </t>
            </div>

        </div>
    </t>

</templates>
